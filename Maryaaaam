  <script>
    const passwordOverlay = document.getElementById('passwordOverlay');
    const passwordInput = document.getElementById('passwordInput');
    const submitPasswordBtn = document.getElementById('submitPasswordBtn');
    const errorMsg = document.getElementById('errorMsg');

    const introOverlay = document.getElementById('introOverlay');
    const normalBtn = document.getElementById('normalBtn');
    const escapeBtn = document.getElementById('escapeBtn');
    const introMsg = document.getElementById('introMsg');

    let wrongAttempts = 0;
    let escapeClicks = 0;

    function checkPassword() {
      const val = passwordInput.value.trim();
      if (val === "البرنصيصة") {
        passwordOverlay.style.opacity = '0';
        setTimeout(() => {
          passwordOverlay.style.display = 'none';
          introOverlay.style.display = 'flex';
        }, 500);
      } else {
        wrongAttempts++;
        if (wrongAttempts === 1) {
          errorMsg.textContent = "انتي شو لقبكك ؟";
        } else {
          errorMsg.textContent = "يااااا هدره بساعدك انتي وايد غبية اول حرف البرنصيصة ترى ما بقى الا اني اكتب عنك 😂";
        }
        passwordInput.value = "";
      }
    }

    submitPasswordBtn.addEventListener('click', checkPassword);
    passwordInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        checkPassword();
      }
    });

    // منطق الزر الهارب
    function moveEscapeButton() {
      const x = Math.random() * 160 - 80;
      const y = Math.random() * 80 - 40;
      escapeBtn.style.transform = `translate(${x}px, ${y}px)`;
    }

    escapeBtn.addEventListener('mouseover', moveEscapeButton);
    escapeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      escapeClicks++;
      if (escapeClicks === 1) {
        introMsg.textContent = "اصبري فكري بالموضوع 🙂";
        escapeBtn.textContent = "لا ما ابي افكر";
        moveEscapeButton();
      } else if (escapeClicks === 2) {
        introMsg.textContent = "خلص خلص ما بعيدها";
        escapeBtn.textContent = "اكللهوااااااا";
        moveEscapeButton();
      } else if (escapeClicks >= 3) {
        escapeBtn.style.display = 'none';
        introMsg.textContent = "";
        normalBtn.textContent = "رؤية الهدية";
        normalBtn.style.transform = "scale(1.3)";
        normalBtn.style.padding = "2.2vmin 5vmin";
        normalBtn.style.fontSize = "2.8vmin";
      }
    });

    // الضغط على الزر الطبيعي لفتح الحديقة وتشغيل الأغنية
    const bgAudio = document.getElementById('bgAudio');
    const musicToggleBtn = document.getElementById('musicToggleBtn');
    let isPlaying = false;

    normalBtn.addEventListener('click', () => {
      bgAudio.play().then(() => {
        isPlaying = true;
        musicToggleBtn.style.background = "rgba(255, 105, 180, 0.6)";
      }).catch(err => {
        console.log("Autoplay blocked:", err);
      });

      introOverlay.style.opacity = '0';
      setTimeout(() => {
        introOverlay.style.display = 'none';
        document.body.classList.remove("not-loaded");
      }, 500);
    });

    window.onload = () => {
      const moonBtn = document.getElementById('moonBtn');
      const modalOverlay = document.getElementById('modalOverlay');
      const envelopeBtn = document.getElementById('envelopeBtn');
      const letterCard = document.getElementById('letterCard');
      const closeBtn = document.getElementById('closeBtn');

      musicToggleBtn.addEventListener('click', () => {
        if (!isPlaying) {
          bgAudio.play().then(() => {
            isPlaying = true;
            musicToggleBtn.style.background = "rgba(255, 105, 180, 0.6)";
          }).catch(err => {
            console.log("Audio play error:", err);
          });
        } else {
          bgAudio.pause();
          isPlaying = false;
          musicToggleBtn.style.background = "rgba(255, 105, 180, 0.25)";
        }
      });

      moonBtn.addEventListener('click', () => {
        modalOverlay.classList.add('active');
        envelopeBtn.style.display = 'flex';
        envelopeBtn.classList.remove('opening');
        letterCard.classList.remove('open-card');
      });

      envelopeBtn.addEventListener('click', () => {
        envelopeBtn.classList.add('opening');
        setTimeout(() => {
          envelopeBtn.style.display = 'none';
          letterCard.classList.add('open-card');
        }, 350);
      });

      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        modalOverlay.classList.remove('active');
        envelopeBtn.style.display = 'flex';
        envelopeBtn.classList.remove('opening');
        letterCard.classList.remove('open-card');
      });

      modalOverlay.addEventListener('click', (e) => {
        if (e.target === modalOverlay) {
          modalOverlay.classList.remove('active');
          envelopeBtn.style.display = 'flex';
          envelopeBtn.classList.remove('opening');
          letterCard.classList.remove('open-card');
        }
      });
    };
  </script>
</body>
</html>
