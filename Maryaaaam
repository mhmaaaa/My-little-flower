<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Magical Romantic Garden for Maryam</title>
  <style>
    *,
    *::after,
    *::before {
      padding: 0;
      margin: 0;
      box-sizing: border-box;
    }

    :root {
      --dark-color: #000;
    }

    body {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      min-height: 100vh;
      background-color: var(--dark-color);
      overflow: hidden;
      perspective: 1000px;
    }

    /* شاشة كلمة السر الفاخرة */
    .password-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: radial-gradient(circle at center, #1a001a 0%, #000000 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 300;
      transition: opacity 0.5s ease;
    }
    .password-card {
      background: rgba(35, 12, 35, 0.95);
      border: 3px solid rgba(255, 105, 180, 0.6);
      border-radius: 3vmin;
      padding: 6vmin;
      width: 85vmin;
      max-width: 92vw;
      text-align: center;
      box-shadow: 0 0 5vmin rgba(255, 105, 180, 0.5);
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .password-card h2 {
      color: #ff80ab;
      font-size: 3.5vmin;
      margin-bottom: 2.5vmin;
      text-shadow: 0 0 1.5vmin rgba(255, 128, 171, 0.6);
    }
    .password-card input {
      width: 80%;
      padding: 2vmin;
      font-size: 2.5vmin;
      border-radius: 50vmin;
      border: 2px solid #ff80ab;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      text-align: center;
      outline: none;
      margin-bottom: 2.5vmin;
    }
    .password-card button {
      background: linear-gradient(135deg, #e91e63, #ff4081);
      color: white;
      border: none;
      padding: 1.5vmin 4vmin;
      font-size: 2.5vmin;
      font-weight: bold;
      border-radius: 50vmin;
      cursor: pointer;
      box-shadow: 0 0 2vmin rgba(233, 30, 99, 0.7);
      transition: transform 0.2s;
    }
    .password-card button:hover {
      transform: scale(1.08);
    }
    .error-msg {
      color: #ff5252;
      font-size: 2.1vmin;
      margin-top: 1.8vmin;
      font-weight: bold;
      line-height: 1.6;
      min-height: 4vmin;
    }

    /* واجهة الانتقال والزر الهارب */
    .intro-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: radial-gradient(circle at center, #120018 0%, #000000 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 250;
      transition: opacity 0.5s ease;
    }
    .intro-card {
      background: rgba(25, 10, 30, 0.95);
      border: 3px solid rgba(255, 105, 180, 0.6);
      border-radius: 3vmin;
      padding: 5vmin;
      width: 85vmin;
      max-width: 92vw;
      text-align: center;
      box-shadow: 0 0 6vmin rgba(255, 105, 180, 0.4);
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
      direction: rtl;
    }
    .intro-card p {
      font-size: 2.8vmin;
      line-height: 1.9;
      color: #ffc1e3;
      margin-bottom: 4vmin;
      white-space: pre-line;
      text-shadow: 0 0 1vmin rgba(255, 193, 227, 0.4);
    }
    .buttons-container {
      display: flex;
      justify-content: center;
      gap: 3vmin;
      align-items: center;
      position: relative;
      min-height: 10vmin;
    }
    .btn-normal {
      background: linear-gradient(135deg, #e91e63, #ff4081);
      color: white;
      border: none;
      padding: 1.8vmin 3.5vmin;
      font-size: 2.4vmin;
      font-weight: bold;
      border-radius: 50vmin;
      cursor: pointer;
      box-shadow: 0 0 2vmin rgba(233, 30, 99, 0.7);
      transition: all 0.3s ease;
      z-index: 5;
    }
    .btn-escape {
      background: linear-gradient(135deg, #424242, #616161);
      color: white;
      border: none;
      padding: 1.8vmin 3.5vmin;
      font-size: 2.4vmin;
      font-weight: bold;
      border-radius: 50vmin;
      cursor: pointer;
      box-shadow: 0 0 2vmin rgba(100, 100, 100, 0.7);
      transition: transform 0.15s ease, background 0.3s ease;
      position: relative;
    }
    .intro-msg {
      color: #ff5252;
      font-size: 2.1vmin;
      margin-top: 2vmin;
      font-weight: bold;
      min-height: 3vmin;
    }

    .night {
      position: fixed;
      left: 50%;
      top: 0;
      transform: translateX(-50%);
      width: 100%;
      height: 100%;
      filter: blur(0.1vmin);
      background-image: radial-gradient(
          ellipse at top,
          transparent 0%,
          var(--dark-color)
        ),
        radial-gradient(
          ellipse at bottom,
          var(--dark-color),
          rgba(145, 233, 255, 0.22)
        ),
        repeating-linear-gradient(
          220deg,
          rgb(0, 0, 0) 0px,
          rgb(0, 0, 0) 19px,
          transparent 19px,
          transparent 22px
        ),
        repeating-linear-gradient(
          189deg,
          rgb(0, 0, 0) 0px,
          rgb(0, 0, 0) 19px,
          transparent 19px,
          transparent 22px
        ),
        repeating-linear-gradient(
          148deg,
          rgb(0, 0, 0) 0px,
          rgb(0, 0, 0) 19px,
          transparent 19px,
          transparent 22px
        ),
        linear-gradient(90deg, rgb(0, 255, 250), rgb(240, 240, 240));
    }

    /* الشهب المتساقطة */
    .shooting-star {
      position: absolute;
      width: 2vmin;
      height: 2vmin;
      background: #fff;
      border-radius: 50%;
      box-shadow: 0 0 10px #fff, 0 0 20px #00ffff, 0 0 30px #00ffff;
      animation: fall linear infinite;
      opacity: 0;
      z-index: 5;
    }
    .shooting-star::before {
      content: '';
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 15vmin;
      height: 0.2vmin;
      background: linear-gradient(90deg, #fff, transparent);
    }

    @keyframes fall {
      0% {
        transform: translate(0, 0) rotate(315deg);
        opacity: 1;
      }
      100% {
        transform: translate(-70vmin, 70vmin) rotate(315deg);
        opacity: 0;
      }
    }

    .star-1 { top: 5%; left: 80%; animation-duration: 3s; animation-delay: 0s; }
    .star-2 { top: 10%; left: 60%; animation-duration: 4s; animation-delay: 1.5s; }
    .star-3 { top: 2%; left: 40%; animation-duration: 3.5s; animation-delay: 2.5s; }
    .star-4 { top: 15%; left: 90%; animation-duration: 4.5s; animation-delay: 0.8s; }

    /* القمر */
    .moon {
      position: absolute;
      top: 8%;
      right: 12%;
      width: 14vmin;
      height: 14vmin;
      background: radial-gradient(circle at 35% 35%, #fffaed 0%, #ffeaa7 60%, #e1b12c 100%);
      border-radius: 50%;
      box-shadow: 0 0 5vmin 2vmin rgba(255, 250, 237, 0.7),
                  0 0 15vmin 5vmin rgba(107, 240, 255, 0.25);
      z-index: 20;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .moon:hover {
      transform: scale(1.08);
      box-shadow: 0 0 7vmin 3vmin rgba(255, 250, 237, 0.9),
                  0 0 20vmin 8vmin rgba(107, 240, 255, 0.4);
    }
    .moon::before {
      content: "";
      position: absolute;
      top: 25%;
      left: 20%;
      width: 3.5vmin;
      height: 3.5vmin;
      background: rgba(0, 0, 0, 0.08);
      border-radius: 50%;
      box-shadow: 4vmin 3vmin 0 -0.5vmin rgba(0, 0, 0, 0.06),
                  1vmin 6vmin 0 -1vmin rgba(0, 0, 0, 0.05);
    }

    /* زر الموسيقى برمز نوتة موسيقية */
    .music-btn {
      position: absolute;
      top: 8%;
      left: 6%;
      width: 7vmin;
      height: 7vmin;
      background: rgba(255, 105, 180, 0.25);
      border: 2px solid rgba(255, 105, 180, 0.8);
      color: #ff80ab;
      border-radius: 50%;
      font-size: 3vmin;
      cursor: pointer;
      z-index: 50;
      backdrop-filter: blur(5px);
      box-shadow: 0 0 2vmin rgba(255, 105, 180, 0.4);
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .music-btn:hover {
      background: rgba(255, 105, 180, 0.45);
      transform: scale(1.1);
    }

    /* الفراشات */
    .butterfly {
      position: absolute;
      width: 3vmin;
      height: 2.5vmin;
      z-index: 15;
      filter: drop-shadow(0 0 1vmin #00ffff);
      animation: fly-butterfly 9s ease-in-out infinite alternate;
    }
    .butterfly::before, .butterfly::after {
      content: '';
      position: absolute;
      top: 0;
      width: 1.5vmin;
      height: 2.5vmin;
      background: rgba(0, 255, 255, 0.8);
      border-radius: 50% 50% 0 50%;
      animation: wing-flap 0.3s ease-in-out infinite alternate;
    }
    .butterfly::before { left: 0; transform-origin: right center; }
    .butterfly::after { right: 0; transform-origin: left center; transform: scaleX(-1); background: rgba(255, 105, 180, 0.8); }

    .butterfly--2 { animation-duration: 7s; animation-delay: 1s; filter: drop-shadow(0 0 1vmin #ff69b4); }
    .butterfly--3 { animation-duration: 11s; animation-delay: 3s; filter: drop-shadow(0 0 1vmin #ffff00); }
    .butterfly--4 { animation-duration: 8s; animation-delay: 2s; filter: drop-shadow(0 0 1vmin #9932cc); }
    .butterfly--5 { animation-duration: 10s; animation-delay: 0.5s; filter: drop-shadow(0 0 1vmin #00ff7f); }
    .butterfly--6 { animation-duration: 6.5s; animation-delay: 2.5s; filter: drop-shadow(0 0 1vmin #ff4500); }
    .butterfly--7 { animation-duration: 12s; animation-delay: 1.5s; filter: drop-shadow(0 0 1vmin #1e90ff); }
    .butterfly--8 { animation-duration: 8.5s; animation-delay: 4s; filter: drop-shadow(0 0 1vmin #ff1493); }

    @keyframes wing-flap {
      0% { transform: rotateY(0deg); }
      100% { transform: rotateY(60deg); }
    }

    @keyframes fly-butterfly {
      0% { bottom: 25vmin; left: 10%; transform: translate(0, 0) rotate(10deg); }
      33% { bottom: 60vmin; left: 40%; transform: translate(5vmin, -10vmin) rotate(-15deg); }
      66% { bottom: 35vmin; left: 70%; transform: translate(-5vmin, 5vmin) rotate(20deg); }
      100% { bottom: 55vmin; left: 85%; transform: translate(2vmin, -5vmin) rotate(-5deg); }
    }

    /* اليرعات */
    .firefly {
      position: absolute;
      width: 1vmin;
      height: 1vmin;
      background: #adff2f;
      border-radius: 50%;
      box-shadow: 0 0 1.5vmin #adff2f, 0 0 3vmin #7fff00;
      z-index: 12;
      opacity: 0;
      animation: firefly-float 6s ease-in-out infinite alternate;
    }
    @keyframes firefly-float {
      0% { transform: translate(0, 0); opacity: 0.2; }
      50% { opacity: 1; filter: drop-shadow(0 0 0.8vmin #ffeb3b); }
      100% { transform: translate(15vmin, -35vmin); opacity: 0; }
    }

    /* ورود الأرضية */
    .ground-flower {
      position: absolute;
      bottom: 1vmin;
      width: 3vmin;
      height: 3vmin;
      z-index: 11;
      animation: pulse-gflower 3s ease-in-out infinite alternate;
    }
    .ground-flower::before {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle, #ff80ab 30%, transparent 70%);
      border-radius: 50%;
    }
    .ground-flower::after {
      content: '';
      position: absolute;
      top: 35%; left: 35%;
      width: 30%; height: 30%;
      background: #fff;
      border-radius: 50%;
      box-shadow: 0 0 1vmin #fff;
    }

    @keyframes pulse-gflower {
      0% { transform: scale(0.9); filter: brightness(0.9); }
      100% { transform: scale(1.15); filter: brightness(1.3); }
    }

    /* نافذة الرسالة */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }
    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .envelope-container {
      position: relative;
      width: 35vmin;
      height: 24vmin;
      background: #fce4ec;
      border-radius: 1.5vmin;
      box-shadow: 0 1vmin 3vmin rgba(255, 105, 180, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.3s ease;
    }
    .envelope-container:hover {
      transform: scale(1.05);
    }
    .envelope-flap {
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 0;
      border-left: 17.5vmin solid transparent;
      border-right: 17.5vmin solid transparent;
      border-top: 14vmin solid #f8bbd0;
      transform-origin: top;
      transition: transform 0.4s ease;
    }
    .envelope-container.opening .envelope-flap {
      transform: rotateX(180deg);
    }

    .envelope-heart-sticker {
      position: absolute;
      width: 6.5vmin;
      height: 6.5vmin;
      background-color: #e91e63;
      transform: rotate(45deg);
      box-shadow: 0 0 1.5vmin rgba(233, 30, 99, 0.8);
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: heart-beat 1.2s infinite;
    }
    .envelope-heart-sticker::before,
    .envelope-heart-sticker::after {
      content: "";
      position: absolute;
      width: 6.5vmin;
      height: 6.5vmin;
      background-color: #e91e63;
      border-radius: 50%;
    }
    .envelope-heart-sticker::before { top: -3.25vmin; left: 0; }
    .envelope-heart-sticker::after { top: 0; left: -3.25vmin; }

    @keyframes heart-beat {
      0%, 100% { transform: rotate(45deg) scale(1); }
      50% { transform: rotate(45deg) scale(1.15); }
    }

    .envelope-hint {
      position: absolute;
      bottom: -6.5vmin;
      width: 100%;
      text-align: center;
      color: #ff80ab;
      font-family: sans-serif;
      font-size: 2.5vmin;
      font-weight: bold;
      letter-spacing: 0.1vmin;
      text-shadow: 0 0 1vmin rgba(255, 128, 171, 0.6);
    }

    .letter-card {
      position: absolute;
      width: 85vmin;
      max-width: 92vw;
      background: linear-gradient(135deg, rgba(35, 12, 35, 0.95), rgba(18, 18, 30, 0.98));
      border: 3px solid rgba(255, 105, 180, 0.6);
      border-radius: 3vmin;
      padding: 5vmin;
      box-shadow: 0 0 5vmin rgba(255, 105, 180, 0.4), inset 0 0 2vmin rgba(255, 255, 255, 0.08);
      text-align: center;
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
      transform: scale(0.5);
      opacity: 0;
      transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      display: none;
      max-height: 88vh;
      overflow-y: auto;
    }

    .letter-card.open-card {
      display: block;
      transform: scale(1);
      opacity: 1;
    }

    .letter-card h2 {
      color: #ff80ab;
      font-size: 3.8vmin;
      margin-bottom: 2.5vmin;
      text-shadow: 0 0 1.5vmin rgba(255, 128, 171, 0.6);
    }
    .letter-card p {
      color: #ffffff;
      font-size: 2.8vmin;
      line-height: 1.8;
      margin-bottom: 3.5vmin;
      text-align: right;
      direction: rtl;
      white-space: pre-line;
      font-weight: 500;
      text-shadow: 0 0 0.5vmin rgba(255, 255, 255, 0.3);
    }
    .close-letter-btn {
      background: linear-gradient(135deg, #e91e63, #ff4081);
      color: white;
      border: none;
      padding: 1.5vmin 4vmin;
      font-size: 2.5vmin;
      font-weight: bold;
      border-radius: 50vmin;
      cursor: pointer;
      box-shadow: 0 0 2vmin rgba(233, 30, 99, 0.7);
      transition: transform 0.2s;
    }
    .close-letter-btn:hover {
      transform: scale(1.08);
    }

    .flowers {
      position: relative;
      transform: scale(0.9);
    }

    .flower {
      position: absolute;
      bottom: 10vmin;
      transform-origin: bottom center;
      z-index: 10;
      --fl-speed: 0.8s;
    }

    /* 1. المجموعة الرئيسية بالمنتصف */
    .group--main {
      position: absolute;
      bottom: 0;
      left: 0;
      z-index: 10;
    }

    /* 2. الورد الجوري الأحمر المخملي (Red Velvet Rose) - يسار */
    .group--red-velvet {
      position: absolute;
      bottom: 0;
      left: -42vmin;
      transform: scale(0.85);
      z-index: 8;
    }
    .group--red-velvet .flower__leaf {
      width: 10vmin;
      height: 10vmin;
      border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
      background-image: linear-gradient(to top, #300000, #800020, #b71c1c);
      box-shadow: inset 0 0 2.5vmin #1a0000;
    }
    .group--red-velvet .flower__leaf--1 { transform: translate(-20%, -5%) rotate(-25deg); }
    .group--red-velvet .flower__leaf--2 { transform: translate(-50%, -15%) scale(1.1); }
    .group--red-velvet .flower__leaf--3 { transform: translate(-80%, -5%) rotate(25deg); }
    .group--red-velvet .flower__leaf--4 {
      width: 7.5vmin;
      height: 7.5vmin;
      border-radius: 50%;
      transform: translate(-50%, 10%);
      background-image: linear-gradient(to top, #4a0000, #d32f2f);
      z-index: 3;
    }
    .group--red-velvet .flower__white-circle { display: none; }
    .group--red-velvet .flower__light:nth-child(odd) { background-color: #ff1744; }

    /* 3. الوردي الأرجواني الملكي (Magenta / Royal Violet) - يمين */
    .group--magenta-violet {
      position: absolute;
      bottom: 0;
      left: 40vmin;
      transform: scale(0.85);
      z-index: 8;
    }
    .group--magenta-violet .flower__leaf {
      width: 8.5vmin;
      height: 13.5vmin;
      border-radius: 50% 50% 20% 80% / 80% 20% 50% 50%;
      background-image: linear-gradient(to top, #4a148c, #8e24aa, #e91e63);
      box-shadow: inset 0 0 1.5vmin rgba(255, 255, 255, 0.5);
    }
    .group--magenta-violet .flower__white-circle {
      border-radius: 50%;
      background-color: #f48fb1;
      background-image: radial-gradient(circle, #ce93d8 20%, #f06292 80%);
      box-shadow: 0 0 1.5vmin #e91e63;
    }
    .group--magenta-violet .flower__light:nth-child(odd) { background-color: #e040fb; }

    /* 4. عباد الشمس الدافئ (Sunflower Warm Amber Gold) - خلف اليسار */
    .group--sunflower-amber {
      position: absolute;
      bottom: 6vmin;
      left: -25vmin;
      transform: scale(0.8);
      z-index: 5;
    }
    .group--sunflower-amber .flower__leaf {
      width: 7.5vmin;
      height: 14.5vmin;
      border-radius: 40% 60% 20% 80% / 70% 30% 70% 30%;
      background-image: linear-gradient(to top, #e65100, #ff9800, #ffeb3b);
      box-shadow: inset 0 0 1.2vmin rgba(255, 255, 255, 0.6);
    }
    .group--sunflower-amber .flower__white-circle {
      width: 6vmin;
      height: 6vmin;
      left: -3vmin;
      top: -2vmin;
      background-color: #3e2723;
      background-image: radial-gradient(circle, #1b0000 40%, #5d4037 90%);
      border-radius: 50%;
      box-shadow: 0 0 1vmin #ff9800;
    }
    .group--sunflower-amber .flower__light:nth-child(odd) { background-color: #ffd54f; }

    /* 5. الورد الأبيض اللؤلؤي (White Rose / Pearl) - خلف اليمين */
    .group--white-pearl {
      position: absolute;
      bottom: 6vmin;
      left: 22vmin;
      transform: scale(0.82);
      z-index: 6;
    }
    .group--white-pearl .flower__leaf {
      width: 9.5vmin;
      height: 13vmin;
      border-radius: 50% 50% 40% 60% / 60% 40% 50% 50%;
      background-color: #ffffff;
      background-image: linear-gradient(to top, #cfd8dc, #eceff1, #ffffff);
      box-shadow: inset 0 0 2vmin rgba(255, 255, 255, 0.9), 0 0 1vmin rgba(207, 216, 220, 0.5);
    }
    .group--white-pearl .flower__white-circle {
      border-radius: 50%;
      background-color: #fff9c4;
      background-image: radial-gradient(circle, #fff59d 30%, #fffde7 80%);
      box-shadow: 0 0 2vmin #ffffff;
    }
    .group--white-pearl .flower__light:nth-child(odd) { background-color: #ffffff; }

    /* 6. غابات البامبو الطويلة على الأطراف */
    .group--bamboo-left {
      position: absolute;
      bottom: 0;
      left: -52vmin;
      z-index: 9;
      transform: scale(1);
    }
    .group--bamboo-right {
      position: absolute;
      bottom: 0;
      left: 48vmin;
      z-index: 9;
      transform: scale(1);
    }

    .bamboo-stalk {
      position: absolute;
      bottom: 0;
      width: 1.6vmin;
      height: 90vmin;
      background: linear-gradient(90deg, #1b5e20, #388e3c, #66bb6a);
      border-radius: 0.8vmin;
      box-shadow: inset 0 0 1vmin rgba(0,0,0,0.6);
      transform-origin: bottom center;
      animation: sway-bamboo 5s ease-in-out infinite alternate;
    }
    .bamboo-stalk::before, .bamboo-stalk::after {
      content: '';
      position: absolute;
      left: -0.2vmin;
